server1 :
	port : 7500
	root : ./server00
	index : /html/index.html
	timeout : 40
	allow_methods : GET
	locations :
		- /html :
			allow_methods : GET
		- /img :
			allow_methods : GET
		- /uploads :
			allow_methods :
		- /scripts :
			allow_methods :
				- GET
				- POST
	cgi_handlers :
		- .py : /usr/bin/python3
#	error_files :
#			- 404 : /errors/404.html
	execution_folder : /scripts
