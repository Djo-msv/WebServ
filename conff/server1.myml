server1 :
	port : 7501
	root : ./server00
	index : /html/index.html
	timeout : 40
	allow_methods : GET
	locations :
		- /html :
			allow_methods : GET
			index : index.html
		- /img :
			allow_methods : GET
		- /uploads :
			allow_methods : DELETE
		- /scripts :
			allow_methods :
				- GET
				- POST
		- /logs :
			allow_methods : POST
			index : findout.txt
	cgi_handlers :
		- .py : /usr/bin/python3
	execution_folder : /scripts
