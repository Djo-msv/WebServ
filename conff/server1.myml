server1 :
	port : 7501
	root : ./server00
	timeout : 40
	allow_methods : GET
	max_body : 40000000
	list_files : true
	locations :
		- /old_html :
			redirect :
				code : 307
				url : /html
			allow_methods : GET
		- /html :
			allow_methods : GET
			index : index.html
		- /img :
			allow_methods : GET
		- /uploads :
			list_files : true
			allow_methods : DELETE
		- /scripts :
			list_files : true
			allow_methods :
				- GET
				- POST
		- /logs :
			index : findout.txt
			allow_methods :
				- POST
				- GET
		- /php :
			index : nyancat.php
			allow_methods : 
				- POST
				- GET
		- /index.html :
			alias : ./server00/html/index.html
			allow_methods : GET
		- /index :
			alias : ./server00/html/index.html
			allow_methods : GET
	cgi_handlers :
		- .py : /usr/bin/python3
		- .php : /usr/bin/php
	execution_folder : /scripts
	upload_folder : /logs
