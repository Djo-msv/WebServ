server2 :
	port : 7500
	root : ./YoupiBanane
	timeout : 10
	allow_methods : GET
	list_files : true
	locations :
		- /directory :
			index : youpi.bad_extension
			alias : ./YoupiBanane
			allow_methods : GET
		- .bla :
			allow_methods : POST
		- /post_body :
			allow_methods : POST
		- /nop :
			allow_methods : GET
			list_files : true
	cgi_handlers :
		- .bla : ./cgi_tester
	execution_folder : .bla
	upload_folder : /post_body
